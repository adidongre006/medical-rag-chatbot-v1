# Copy to `.env` (never commit `.env`). See guide.md section 3 for where to get each value.

# --- Required ---------------------------------------------------------------
PINECONE_API_KEY=your-pinecone-api-key
HF_TOKEN=your-huggingface-token

# --- RAG (defaults shown) ---------------------------------------------------
PINECONE_INDEX=medical-chatbot
HF_REPO_ID=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_NEW_TOKENS=512
RETRIEVER_K=3

# --- HTTP -------------------------------------------------------------------
# Comma-separated list (or JSON list) of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# <count>/<second|minute|hour|day>, per client IP, per process.
RATE_LIMIT=20/minute
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Legacy (unused; safe to delete) ---------------------------------------
# OPENAI_API_KEY=
